# Porta HTTP do servidor
PORT=8080
# Senha do painel /admin e das ações de administração (criar brejos, derrubar o servidor)
ADMIN_KEY=troque-esta-chave
# Segredo usado para assinar os tokens de login (se vazio, é gerado e salvo no banco)
TOKEN_SECRET=
# Com DATABASE_URL o servidor usa PostgreSQL; sem ela, usa SQLite no arquivo abaixo
DATABASE_URL=
SQLITE_PATH=data/pererecario.db
# Opcional: chave gratuita do mapa CARTO (carto.com/basemaps/apikey). Vazio = mapa padrão do OpenStreetMap
CARTO_KEY=
